{
  "name": "rxdb-orion",
  "description": "RxDB replication for Laravel Orion",
  "readmeFilename": "README.md",
  "version": "0.10.3",
  "license": "MIT",
  "keywords": [
    "laravel",
    "orion",
    "replication",
    "rxdb",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/serenysoft/rxdb-orion"
  },
  "bugs": {
    "url": "https://github.com/serenysoft/rxdb-orion/issues"
  },
  "author": {
    "name": "Leandro Guindani Gehlen",
    "email": "leandrogehlen@gmail.com"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rimraf -rf dist/ && tsc --project tsconfig.dist.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "release": "release-it --only-version",
    "test": "cross-env NODE_ENV=testing jest --verbose --runInBand",
    "test:ci": "cross-env NODE_ENV=testing jest --verbose --collect-coverage --runInBand"
  },
  "engines": {
    "node": ">= 16"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "rxdb": "^16.0.0||^17.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "node-fetch": "^2.7.0",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": false,
      "commitMessage": "Release v${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "npm run build"
      ]
    }
  }
}
